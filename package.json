{
  "name": "cloudsmith-vsc",
  "publisher": "Cloudsmith",
  "displayName": "Cloudsmith VS Code",
  "description": "Access packages from a Cloudsmith instance.",
  "version": "2.3.0",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/cloudsmith-labs/cloudsmith-vscode-extension/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/cloudsmith-labs/cloudsmith-vscode-extension/issues",
    "email": "support@cloudsmith.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudsmith-labs/cloudsmith-vscode-extension"
  },
  "icon": "media/logo.png",
  "files": [
    "extension.js",
    "commands/**/*.js",
    "domain/**/*.js",
    "models/**/*.js",
    "util/**/*.js",
    "views/**/*.js",
    "media/icon.svg",
    "media/logo.png",
    "media/workspace_dark.svg",
    "media/workspace_light.svg",
    "media/readme/brand-banner.png",
    "media/vscode_icons/file_type_alpine.svg",
    "media/vscode_icons/file_type_cargo.svg",
    "media/vscode_icons/file_type_composer.svg",
    "media/vscode_icons/file_type_conan.svg",
    "media/vscode_icons/file_type_conda.svg",
    "media/vscode_icons/file_type_dart.svg",
    "media/vscode_icons/file_type_deb.svg",
    "media/vscode_icons/file_type_docker.svg",
    "media/vscode_icons/file_type_elixir.svg",
    "media/vscode_icons/file_type_go.svg",
    "media/vscode_icons/file_type_helm.svg",
    "media/vscode_icons/file_type_lua.svg",
    "media/vscode_icons/file_type_maven.svg",
    "media/vscode_icons/file_type_npm.svg",
    "media/vscode_icons/file_type_nuget.svg",
    "media/vscode_icons/file_type_python.svg",
    "media/vscode_icons/file_type_r.svg",
    "media/vscode_icons/file_type_rpm.svg",
    "media/vscode_icons/file_type_ruby.svg",
    "media/vscode_icons/file_type_rust.svg",
    "media/vscode_icons/file_type_swift.svg",
    "media/vscode_icons/file_type_terraform.svg",
    "media/vscode_icons/file_type_vagrant.svg",
    "media/vscode_icons/file_type_light_rust.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTORS.md"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cloudsmithSideBar",
          "title": "Cloudsmith",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cloudsmithSideBar": [
        {
          "id": "cloudsmithView",
          "name": "Workspaces"
        },
        {
          "id": "cloudsmithSearchView",
          "name": "Package search"
        },
        {
          "id": "cloudsmithDependencyHealthView",
          "name": "Dependency health"
        },
        {
          "id": "helpView",
          "name": "Help and feedback"
        }
      ]
    },
    "commands": [
      {
        "command": "cloudsmith-vsc.openSettings",
        "title": "Open Cloudsmith settings",
        "category": "Cloudsmith",
        "icon": "$(gear)"
      },
      {
        "command": "cloudsmith-vsc.configureCredentials",
        "title": "Set up Cloudsmith authentication",
        "category": "Cloudsmith",
        "icon": "$(key)",
        "enablement": "!cloudsmith.connected && cloudsmith.connectionSetupAvailable"
      },
      {
        "command": "cloudsmith-vsc.connectCloudsmith",
        "title": "Connect to Cloudsmith",
        "category": "Cloudsmith",
        "icon": "$(plug)",
        "enablement": "!cloudsmith.connected && cloudsmith.connectionSetupAvailable && cloudsmith.credentialsPresent"
      },
      {
        "command": "cloudsmith-vsc.clearCredentials",
        "title": "Clear stored credentials",
        "category": "Cloudsmith",
        "icon": "$(sign-out)",
        "enablement": "cloudsmith.credentialsPresent"
      },
      {
        "command": "cloudsmith-vsc.copySelected",
        "title": "Copy value",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.inspectPackage",
        "title": "Inspect package",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.inspectPackageGroup",
        "title": "Inspect package group",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.openPackage",
        "title": "View package in Cloudsmith",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.openPackageGroup",
        "title": "View package group in Cloudsmith",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.refreshView",
        "title": "Refresh",
        "category": "Cloudsmith",
        "icon": "$(refresh)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vscode-extension.cloudsmithDocs",
        "category": "Cloudsmith",
        "title": "View Cloudsmith documentation"
      },
      {
        "command": "cloudsmith-vsc.searchPackages",
        "title": "Search packages",
        "category": "Cloudsmith",
        "icon": "$(search)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.clearSearch",
        "title": "Clear search results",
        "category": "Cloudsmith",
        "icon": "$(clear-all)",
        "enablement": "cloudsmith.connected && cloudsmith.searchActive"
      },
      {
        "command": "cloudsmith-vsc.searchNextPage",
        "title": "Load more results",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected && cloudsmith.searchCanLoadMore"
      },
      {
        "command": "cloudsmith-vsc.loadMoreRepositoryPackages",
        "title": "Load more repository packages",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.searchInWorkspace",
        "title": "Search packages in this workspace",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.guidedSearch",
        "title": "Advanced search",
        "category": "Cloudsmith",
        "icon": "$(list-filter)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.filterPackages",
        "title": "Filter packages in this repository",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.clearFilter",
        "title": "Clear package filter",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.changeFilter",
        "title": "Change package filter",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.findSafeVersion",
        "title": "Find safe version",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.openCVE",
        "title": "Open CVE in browser",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.showVulnerabilities",
        "title": "Show vulnerabilities",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.showDepVulnerabilities",
        "title": "Show vulnerabilities",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.findDepSafeVersion",
        "title": "Find safe version",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.filterVulnerabilities",
        "title": "Filter vulnerabilities",
        "category": "Cloudsmith",
        "icon": "$(filter)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.explainQuarantine",
        "title": "Explain quarantine",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.scanDependencies",
        "title": "Scan dependencies",
        "category": "Cloudsmith",
        "icon": "$(play)",
        "enablement": "cloudsmith.connected && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.changeDependencyScanScope",
        "title": "Change dependency scan scope",
        "category": "Cloudsmith",
        "icon": "$(folder-opened)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.pullDependencies",
        "title": "Pull dependencies",
        "category": "Cloudsmith",
        "icon": "$(cloud-download)",
        "enablement": "cloudsmith.connected && cloudsmith.pullThroughAvailable && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.pullSingleDependency",
        "title": "Pull dependency",
        "category": "Cloudsmith",
        "icon": "$(cloud-download)",
        "enablement": "cloudsmith.connected && cloudsmith.pullThroughAvailable && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.cycleDepView",
        "title": "Cycle dependency view",
        "category": "Cloudsmith",
        "icon": "$(symbol-enum)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depViewDirect",
        "title": "Show direct dependencies",
        "category": "Cloudsmith",
        "icon": "$(list-selection)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depViewFlat",
        "title": "Show all dependencies (flat)",
        "category": "Cloudsmith",
        "icon": "$(list-unordered)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depViewTree",
        "title": "Show dependency tree",
        "category": "Cloudsmith",
        "icon": "$(list-tree)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depFilterVulnerable",
        "title": "Show only vulnerable",
        "category": "Cloudsmith",
        "icon": "$(warning)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depFilterUncovered",
        "title": "Show only not in Cloudsmith",
        "category": "Cloudsmith",
        "icon": "$(package)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depFilterRestrictiveLicense",
        "title": "Show only restrictive licenses",
        "category": "Cloudsmith",
        "icon": "$(law)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depFilterPolicyViolation",
        "title": "Show only policy violations",
        "category": "Cloudsmith",
        "icon": "$(shield)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depFilterClear",
        "title": "Clear dependency filters",
        "category": "Cloudsmith",
        "icon": "$(clear-all)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.depSortFilter",
        "title": "Sort & filter dependencies",
        "category": "Cloudsmith",
        "icon": "$(filter)",
        "enablement": "cloudsmith.connected && cloudsmith.depScanSucceeded && !cloudsmith.depOperationRunning"
      },
      {
        "command": "cloudsmith-vsc.viewComplianceReport",
        "title": "View compliance report",
        "category": "Cloudsmith",
        "icon": "$(graph)",
        "enablement": "cloudsmith.connected && cloudsmith.depReportAvailable"
      },
      {
        "command": "cloudsmith-vsc.copyInstallCommand",
        "title": "Copy install command",
        "category": "Cloudsmith",
        "icon": "$(terminal)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.showInstallCommand",
        "title": "Show install command",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.searchByLicense",
        "title": "Search packages by license",
        "category": "Cloudsmith",
        "icon": "$(law)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.openLicenseUrl",
        "title": "View license",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.ssoLogin",
        "title": "Sign in with SSO",
        "category": "Cloudsmith",
        "icon": "$(globe)",
        "enablement": "!cloudsmith.connected && cloudsmith.connectionSetupAvailable"
      },
      {
        "command": "cloudsmith-vsc.importCLICredentials",
        "title": "Import API key from Cloudsmith CLI",
        "category": "Cloudsmith",
        "icon": "$(folder-opened)",
        "enablement": "!cloudsmith.connected && cloudsmith.connectionSetupAvailable"
      },
      {
        "command": "cloudsmith-vsc.setDefaultWorkspace",
        "title": "Set default workspace",
        "category": "Cloudsmith",
        "icon": "$(home)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.previewUpstreamResolution",
        "title": "Preview upstream resolution",
        "category": "Cloudsmith",
        "icon": "$(cloud)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.inspectUpstreams",
        "title": "View upstreams",
        "category": "Cloudsmith",
        "icon": "$(cloud)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.exportTerraform",
        "title": "Export as Terraform",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.showPromotionStatus",
        "title": "Show promotion status",
        "category": "Cloudsmith",
        "icon": "$(git-compare)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.promotePackage",
        "title": "Promote package",
        "category": "Cloudsmith",
        "icon": "$(arrow-right)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.copyEntitlementToken",
        "title": "Copy entitlement token",
        "category": "Cloudsmith",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.filterVulnerable",
        "title": "Show vulnerable packages",
        "category": "Cloudsmith",
        "icon": "$(shield)",
        "enablement": "cloudsmith.connected"
      },
      {
        "command": "cloudsmith-vsc.filterVulnerableWorkspace",
        "title": "Show vulnerable packages (all repositories)",
        "category": "Cloudsmith",
        "icon": "$(shield)",
        "enablement": "cloudsmith.connected"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cloudsmith-vsc.copySelected",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.inspectPackageGroup",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.openPackageGroup",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.loadMoreRepositoryPackages",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.searchInWorkspace",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.filterPackages",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.clearFilter",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.changeFilter",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.filterVulnerable",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.filterVulnerableWorkspace",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.openCVE",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.showDepVulnerabilities",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.findDepSafeVersion",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.filterVulnerabilities",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.pullSingleDependency",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.openLicenseUrl",
          "when": "false"
        },
        {
          "command": "cloudsmith-vsc.copyEntitlementToken",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "cloudsmith-vsc.inspectPackage",
          "when": "view == cloudsmithView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.inspect(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.inspectPackageGroup",
          "when": "view == cloudsmithView && viewItem == packageGroup",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.copySelected",
          "when": "view == cloudsmithView && viewItem == packageDetail",
          "group": "9_cutcopypaste"
        },
        {
          "command": "cloudsmith-vsc.openPackage",
          "when": "view == cloudsmithView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.open(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.openPackageGroup",
          "when": "view == cloudsmithView && viewItem == packageGroup",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.searchInWorkspace",
          "when": "view == cloudsmithView && viewItem == workspace",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.filterVulnerableWorkspace",
          "when": "view == cloudsmithView && viewItem == workspace",
          "group": "filter@3"
        },
        {
          "command": "cloudsmith-vsc.inspectPackage",
          "when": "view == cloudsmithSearchView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.inspect(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.openPackage",
          "when": "view == cloudsmithSearchView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.open(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.inspectPackage",
          "when": "view == cloudsmithDependencyHealthView && viewItem =~ /^dependencyHealthActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.inspect(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.openPackage",
          "when": "view == cloudsmithDependencyHealthView && viewItem =~ /^dependencyHealthActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.open(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.filterPackages",
          "when": "view == cloudsmithView && viewItem == repository",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.filterPackages",
          "when": "view == cloudsmithView && viewItem == repositoryFiltered",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.changeFilter",
          "when": "view == cloudsmithView && viewItem == repositoryFiltered",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.clearFilter",
          "when": "view == cloudsmithView && viewItem == repositoryFiltered",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.filterVulnerable",
          "when": "view == cloudsmithView && viewItem == repository",
          "group": "filter@3"
        },
        {
          "command": "cloudsmith-vsc.inspectUpstreams",
          "when": "view == cloudsmithView && viewItem =~ /^(repository|repositoryFiltered|upstreamIndicator)$/",
          "group": "navigation@2"
        },
        {
          "command": "cloudsmith-vsc.exportTerraform",
          "when": "view == cloudsmithView && viewItem == repository",
          "group": "cloudsmith.export"
        },
        {
          "command": "cloudsmith-vsc.exportTerraform",
          "when": "view == cloudsmithView && viewItem == repositoryFiltered",
          "group": "cloudsmith.export"
        },
        {
          "command": "cloudsmith-vsc.filterVulnerable",
          "when": "view == cloudsmithView && viewItem == repositoryFiltered",
          "group": "filter@3"
        },
        {
          "command": "cloudsmith-vsc.copySelected",
          "when": "view == cloudsmithSearchView && viewItem == packageDetail",
          "group": "9_cutcopypaste"
        },
        {
          "command": "cloudsmith-vsc.findSafeVersion",
          "when": "view == cloudsmithView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.findSafeVersion(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.findSafeVersion",
          "when": "view == cloudsmithSearchView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.findSafeVersion(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.openCVE",
          "when": "view == cloudsmithView && viewItem == vulnerability",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.openCVE",
          "when": "view == cloudsmithSearchView && viewItem == vulnerability",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.openCVE",
          "when": "view == cloudsmithDependencyHealthView && viewItem == vulnerability",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.showVulnerabilities",
          "when": "view == cloudsmithView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.showVulnerabilities(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.showVulnerabilities",
          "when": "view == cloudsmithSearchView && viewItem =~ /^packageActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.showVulnerabilities(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.showDepVulnerabilities",
          "when": "view == cloudsmithDependencyHealthView && viewItem =~ /^dependencyHealthActions(?:\\.[A-Za-z][A-Za-z0-9]*)*\\.showVulnerabilities(?:\\.|$)/",
          "group": "navigation"
        },
        {
          "command": "cloudsmith-vsc.findDepSafeVersion",
