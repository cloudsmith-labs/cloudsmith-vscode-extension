    "configuration": {
      "title": "Cloudsmith",
      "properties": {
        "cloudsmith-vsc.inspectOutput": {
          "type": "boolean",
          "default": false,
          "description": "Open inspect results in a text document. By default, results are sent to the Output panel."
        },
        "cloudsmith-vsc.showMaxPackages": {
          "type": "integer",
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "description": "Packages loaded per page in the repository tree. Use Load More to continue, up to the 600-package safety bound per expansion."
        },
        "cloudsmith-vsc.groupByPackageGroups": {
          "type": "boolean",
          "default": false,
          "description": "Group packages by package group."
        },
        "cloudsmith-vsc.showPermissibilityIndicators": {
          "type": "boolean",
          "default": true,
          "description": "Show visual indicators for package permissibility status (quarantined, policy violations). When disabled, format-based icons are used for all packages."
        },
        "cloudsmith-vsc.searchPageSize": {
          "type": "integer",
          "default": 50,
          "minimum": 10,
          "maximum": 100,
          "description": "Number of results per repository for Advanced Search across selected repositories. Workspace and single-repository searches request at most 10 results per page."
        },
        "cloudsmith-vsc.recentSearches": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "description": "Number of recent searches to remember."
        },
        "cloudsmith-vsc.defaultWorkspace": {
          "type": "string",
          "default": "",
          "description": "Cloudsmith workspace slug to use by default. When set, repositories load directly without a workspace picker. Leave empty to show all accessible workspaces."
        },
        "cloudsmith-vsc.autoScanOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated compatibility setting. This setting has no effect.",
          "deprecationMessage": "This setting has no effect and is retained only so existing configuration remains valid."
        },
        "cloudsmith-vsc.dependencyScanWorkspace": {
          "type": "string",
          "default": "",
          "description": "Cloudsmith workspace slug to use for dependency health scanning. Leave empty to be prompted each time."
        },
        "cloudsmith-vsc.dependencyScanRepo": {
          "type": "string",
          "default": "",
          "description": "Cloudsmith repository slug to use for dependency health scanning. Leave empty to search the full workspace."
        },
        "cloudsmith-vsc.maxDependenciesToScan": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum number of dependencies to display in the Dependency Health view. Pull operations always process all resolved dependencies."
        },
        "cloudsmith-vsc.showLicenseIndicators": {
          "type": "boolean",
          "default": true,
          "description": "Show license risk classification on packages. When disabled, license nodes are hidden."
        },
        "cloudsmith-vsc.flagRestrictiveLicenses": {
          "type": "boolean",
          "default": true,
          "description": "Highlight restrictive licenses inline in the Dependency Health view."
        },
        "cloudsmith-vsc.showDockerDigestCommand": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated compatibility setting. Exact Docker digest pulls are generated automatically when canonical package identity includes a manifest digest.",
          "deprecationMessage": "This setting has no effect; exact Docker digest pulls are now automatic. It is retained only so existing configuration remains valid."
        },
        "cloudsmith-vsc.resolveTransitiveDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Parse lockfiles to resolve transitive dependencies. When disabled, only direct manifest dependencies are shown."
        },
        "cloudsmith-vsc.dependencyTreeDefaultView": {
          "type": "string",
          "enum": ["direct", "flat", "tree"],
          "default": "flat",
          "description": "Default view mode for the Dependency Health panel."
        },
        "cloudsmith-vsc.showLegacyPolicies": {
          "type": "boolean",
          "default": false,
          "description": "Show classic policy violation fields (deny, license, vulnerability). Disable if the workspace uses current policy management."
        },
        "cloudsmith-vsc.restrictiveLicenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["AGPL-3.0", "GPL-3.0", "GPL-2.0", "SSPL-1.0"],
          "description": "SPDX identifiers to treat as restrictive. Packages with these licenses will be flagged. These extend the built-in restrictive set."
        },
        "cloudsmith-vsc.promotionPipeline": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Optional ordered list of repository slugs for the promotion pipeline (for example, ['dev', 'staging', 'production']). When set, promotion suggests the next repository in the pipeline. When empty, all workspace repositories are shown."
        },
        "cloudsmith-vsc.promotionTags": {
          "type": "object",
          "default": {
            "onPromote": ["promoted-to-{target}", "approved-{date}"],
            "onReceive": ["promoted-from-{source}"]
          },
          "description": "Tag templates applied when promoting packages. Supports {target}, {source}, {date} placeholders."
        },
        "cloudsmith-vsc.showEntitlements": {
          "type": "boolean",
          "default": false,
          "description": "Show active entitlement tokens under each repository. Useful for debugging download access issues."
        },
        "cloudsmith-vsc.showRepoMetrics": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated compatibility setting. This setting has no effect.",
          "deprecationMessage": "This setting has no effect and is retained only so existing configuration remains valid."
        }
      }
    }
  },
