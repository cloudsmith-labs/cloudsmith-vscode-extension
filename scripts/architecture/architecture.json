{
  "schemaVersion": 1,
  "compositionFile": "extension.js",
  "cycleExemptions": [
    [
      "util/cloudsmithAPI.js",
      "util/connectionManager.js",
      "util/credentialManager.js"
    ]
  ],
  "limits": {
    "maxDepth": 12,
    "maxDiagnostics": 256,
    "maxEntries": 1024,
    "maxFileBytes": 262144,
    "maxFiles": 256,
    "maxImports": 2048,
    "maxTotalBytes": 4194304
  },
  "ignoredSegments": [
    ".git",
    ".vscode-test",
    "build",
    "coverage",
    "dist",
    "generated",
    "node_modules",
    "out",
    "vendor"
  ],
  "adapterFiles": [
    "domain/packageAdapters.js"
  ],
  "canonicalFactoryFiles": [
    "domain/package.js"
  ],
  "commandRegistrationFiles": [
    "commands/registrar.js",
    "commands/authentication.js",
    "commands/settingsHelp.js",
    "commands/packages.js",
    "commands/search.js",
    "commands/dependencyHealth.js",
    "commands/vulnerabilities.js",
    "commands/promotion.js",
    "commands/upstream.js"
  ],
  "runtimeRoots": [
    "commands",
    "domain",
    "models",
    "util",
    "views"
  ],
  "upstreamOwnership": {
    "checkerModule": "util/upstreamChecker.js",
    "constructorExport": "UpstreamChecker",
    "authorityModule": "util/upstreamRuntime.js",
    "authorityExport": "UpstreamRuntime",
    "compositionFile": "extension.js",
    "safeConsumerExports": [
      "isSafeInventoryUpstream",
      "sanitizeSafeInventoryUpstream"
    ],
    "deprecatedAcquisitionExports": [
      "getAllUpstreamData",
      "getUpstreamDataForFormats"
    ]
  },
  "nonJavaScriptPackageFiles": [
    "media/icon.svg",
    "media/logo.png",
    "media/repo.png",
    "media/workspace_dark.svg",
    "media/workspace_light.svg",
    "media/readme/*.gif",
    "media/readme/*.jpg",
    "media/readme/*.png",
    "media/vscode_icons/file_type_*.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTORS.md"
  ],
  "internalCommandIds": [
    "cloudsmith-vsc.scanDependenciesPending",
    "cloudsmith-vsc.scanDependenciesComplete",
    "cloudsmith-vsc.rescanDependencies"
  ],
